# Copier ce fichier en .env.local et remplir avec les valeurs de votre projet Supabase
# (Supabase > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=votre-cle-publique

# E-mails de liste d'attente (facultatif) : voir le README, « E-mails de liste d'attente ».
# Ne jamais partager ces valeurs.
SUPABASE_SECRET_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
